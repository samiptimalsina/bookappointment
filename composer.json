{
    "name": "heartland-computer-team/appointment-heartlandcomputer",
    "description": "Appointment booking and administration module for the Heartland Computer Laravel application.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "aloha/twilio": "^5.0",
        "artesaos/seotools": "^1.1",
        "laravel/framework": "^10.0",
        "laravelcollective/html": "^6.2",
        "spatie/eloquent-sortable": "^4.0",
        "spatie/icalendar-generator": "^2.5",
        "spatie/laravel-google-calendar": "^3.6",
        "spatie/laravel-medialibrary": "^10.9",
        "spatie/laravel-permission": "^5.10",
        "venturecraft/revisionable": "^1.40",
        "yajra/laravel-datatables-oracle": "^10.4"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Appointment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Modules\\Appointment\\Providers\\AppointmentRouteServiceProvider",
                "App\\Modules\\Appointment\\Providers\\AppointmentEventServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
